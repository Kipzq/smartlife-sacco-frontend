# OTP backend configuration. Keep real credentials out of Git and the frontend.
NODE_ENV=development
PORT=4000
WEB_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
REDIS_URL=redis://localhost:6379
OTP_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
OTP_MOCK_MODE=true
SMS_ENABLED=false
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
