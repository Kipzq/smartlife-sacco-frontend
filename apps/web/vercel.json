  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/membership", "destination": "/index.html" },
    { "source": "/member", "destination": "/index.html" }
  ]
}
